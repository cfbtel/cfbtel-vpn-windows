#include <windows.h>

#pragma code_page(65001) // UTF-8

#define STRINGIZE(x) #x
#define EXPAND(x) STRINGIZE(x)

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST manifest.xml
7 ICON ui/icon/wireguard.ico
8 ICON ui/icon/dot.ico
wireguard.dll RCDATA wireguard.dll

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT
VS_VERSION_INFO VERSIONINFO
FILEVERSION    WIREGUARD_VERSION_ARRAY
PRODUCTVERSION WIREGUARD_VERSION_ARRAY
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CFBTEL"
      VALUE "FileDescription", "CFBTEL VPN"
      VALUE "FileVersion", EXPAND(WIREGUARD_VERSION_STR)
      VALUE "InternalName", "cfbtelvpn"
      VALUE "LegalCopyright", "Copyright © 2015-2026 Jason A. Donenfeld. All Rights Reserved. CFBTEL VPN branding © CFBTEL."
      VALUE "OriginalFilename", "cfbtelvpn.exe"
      VALUE "ProductName", "CFBTEL VPN"
      VALUE "ProductVersion", EXPAND(WIREGUARD_VERSION_STR)
      VALUE "Comments", "https://www.cfbtel.com/"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x4b0
  END
END
